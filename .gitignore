# ==============================================================================
# Production .gitignore for Tessy (Next.js 16 + React 19 + TypeScript + libSQL)
# ==============================================================================

# --- Node & Dependencies ---
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# --- Next.js & Build Outputs ---
.next/
out/
build/
dist/
.turbo/
next-env.d.ts
*.tsbuildinfo

# --- Environment & Sensitive Credentials ---
.env*
!.env.example
*.pem
*.key
*.cert

# --- Databases & Local Storage ---
.data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
tessy.db*

# --- Vercel & Deployments ---
.vercel/

# --- Testing & Code Quality ---
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.eslintcache
.prettiercache

# --- Scratchpads, Internal Notes & Agent Artifacts ---
PLAN.md
CLAUDE.md
.claude/
notes/
.scratch/
.gemini/

# --- Operating Systems ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# --- IDEs & Code Editors ---
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
.*.sw[a-p]
*.sublime-workspace
*.sublime-project

# VS Code (Preserve shared team configurations & extensions)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
